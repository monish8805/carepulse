PORT=5001
MONGODB_URI=mongodb://localhost:27017/carepulse
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003

JWT_SECRET=replace-with-a-long-random-string

BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=your-verified-sender@example.com
BREVO_SENDER_NAME=CarePulse

# The sepsis model service (ml-service/start.sh). Keep it on localhost or a
# private network — it has no auth of its own.
ML_SERVICE_URL=http://127.0.0.1:8000

# Used only by `npm run seed:owner`, which creates the initial Platform Owner
# account. The script refuses to run unless both are set — it deliberately has
# no built-in default, since that would be a committed credential for the
# highest-privilege account in the system.
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=replace-with-a-strong-password

# Used only by `npm run replay:vitals`, which replays a held-out ICU stay from
# ml-service/sample_patients.json into this (verified, empty) patient account.
REPLAY_PATIENT_EMAIL=patient@example.com
REPLAY_PATIENT_PASSWORD=replace-with-that-patients-password
