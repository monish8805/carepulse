{
  "name": "carepulse-owner",
  "main": "../workers/api-proxy.ts",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "none",
    "run_worker_first": ["/*", "!/assets/*"]
  },
  "vars": {
    "BACKEND_ORIGIN": "https://carepulse-backend.onrender.com"
  }
}
