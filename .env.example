# Used by docker-compose.yml. Copy to .env (git-ignored) and fill in.
# This is separate from backend/.env, which is for running the backend without Docker.

# Required: a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-string

# Required: shared secret between the backend and the model service, e.g. `openssl rand -hex 32`
ML_API_KEY=replace-with-another-long-random-string

# Optional: defaults to the bundled mongo container. Set to use Atlas instead.
# MONGODB_URI=mongodb+srv://...

# Optional: without a Brevo key, registration/reset OTP emails are not sent.
# BREVO_API_KEY=
# BREVO_SENDER_EMAIL=
# BREVO_SENDER_NAME=CarePulse

# Optional: the public URL the browser uses to reach the backend (compiled into the
# frontend bundles at build time). Change the frontends' origins here too if needed.
# VITE_API_URL=http://localhost:5001
# ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003
